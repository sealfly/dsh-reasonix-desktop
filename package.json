{
  "name": "dsh-(reasonix)UI-desktop",
  "productName": "dsh-(reasonix)UI-desktop",
  "version": "0.1.0",
  "description": "Reasonix frontend + DeepSeek Harness backend bridge desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.reasonix.ui",
    "productName": "dsh-(reasonix)UI-desktop",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "prices.json",
      "LICENSE",
      "install.ps1",
      "start.bat",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "dsh-(reasonix)UI"
    }
  }
}
